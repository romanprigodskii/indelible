      .cta-in {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: var(--space-lg) clamp(2rem, 1rem + 4vw, 5rem);
        align-items: center;
      }

      .cta-lead {
        margin-top: var(--space-sm);
        font-size: var(--text-lg);
        color: var(--night-soft);
      }

      .cmd-box--night {
        margin-top: 0;
        border-color: var(--night-hi);
        background: oklch(0.19 0.022 262);
        color: var(--night-ink);
      }

      .cmd-box--night .prompt {
        color: var(--night-soft);
      }

      .cmd-box--night .copy {
        border-left-color: var(--night-hi);
        background: var(--paper);
        color: var(--print);
      }

      .cmd-box--night .copy:hover {
        background: var(--paper-shade);
      }

      .cta-note {
        margin-top: var(--space-sm);
        font-size: var(--text-sm);
        color: var(--night-soft);
      }

      .cta-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2xs) var(--space-md);
        margin-top: var(--space-sm);
        font-size: var(--text-sm);
        font-weight: 600;
      }

      @media (max-width: 56rem) {
        .cta-in {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ------------------------------------------------ footer */
      .foot {
        padding-block: var(--space-lg);
        background: var(--night);
        border-top: 1px solid var(--night-hi);
        color: var(--night-soft);
        font-size: var(--text-xs);
      }

      .foot-in {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--space-2xs) var(--space-lg);
      }

      .foot-in p:last-child {
        max-width: 38rem;
      }
    </style>
  </body>
</html>
