---
import '@fontsource-variable/public-sans';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Trial from '../components/Trial.astro';
import Planner from '../components/Planner.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const repo = 'https://github.com/romanprigodskii/indelible';
const blob = `${repo}/blob/main`;
const install = [
  'claude plugin marketplace add romanprigodskii/indelible',
  'claude plugin install indelible@indelible',
];

// The method, in the README's words and order.
const rules = [
  { title: 'Read it, then close it.', text: 'Theory comes on its own sheet. You read it and put it away before the drills, because an explanation left in view turns a test into a lookup.' },
  { title: 'One kind at a time, then all mixed.', text: 'Drills come in blocks of one question type. Anything that measures you is shuffled and unlabelled, like the real exam.' },
  { title: 'Nothing counts until it survives 48 hours.', text: 'Every new skill comes back cold two days later, on fresh problems. Same-day scores are practice.' },
  { title: 'Check backwards, in writing.', text: 'Beside every answer you write one check that runs the other way. Solving it again in your head repeats the same slip. A written check catches it.' },
  { title: 'Every miss comes back.', text: 'Each mistake goes in an error log and returns after 1 day, 3 days, 1 week and 3 weeks, until it stays.' },
  { title: 'You do the work.', text: 'You get the smallest hint that unblocks you, never an answer you could reach yourself. When an answer is wrong, you see where, and the fix is yours.' },
];

// The recheck timeline: indelible's default intervals, not measured results.
const stops = [
  { when: 'Day 0', title: 'The lesson', text: 'You read the theory sheet, close it, and do the drills: 6 of 6.', verdict: 'Practice. It does not count yet.', counts: false },
  { when: 'Day 2', title: 'The 2-day recheck', text: 'Fresh numbers, nothing looked at in the 24 hours before, book closed. 3 of 4.', verdict: 'This one counts. The miss goes on the ladder.', counts: true },
  { when: 'Day 3', title: '+1 day', text: 'The miss comes back, after the idea behind it has been fixed.', verdict: 'Passed. Next in 3 days.', counts: true },
  { when: 'Day 6', title: '+3 days', text: 'Again, cold, mixed in with other topics.', verdict: 'Passed. Next in a week.', counts: true },
  { when: 'Day 13', title: '+1 week', text: 'Again, with no heading to say which topic it is.', verdict: 'Passed. Next in 3 weeks.', counts: true },
  { when: 'Day 34', title: '+3 weeks', text: 'The last rung: four passes on four different days.', verdict: 'Retired. It stayed.', counts: true },
];
const pos = (i: number) => `${((i / (stops.length - 1)) * 100).toFixed(2)}%`;
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>indelible · learning that survives the cold test</title>
    <meta name="description" content="An open-source Claude skill that runs your self-study like a strict, kind tutor: theory you read and close, drills checked backwards on paper, and a cold recheck two days later." />
    <meta property="og:title" content="indelible · learning that survives the cold test" />
    <meta property="og:description" content="An open-source Claude skill for self-study. Nothing counts until it survives 48 hours." />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#F8F6F1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="ink" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="1.6" />
      </filter>
    </svg>

    <a class="skip-link" href="#main">Skip to content</a>

    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href={base} aria-label="indelible, home">
          <svg class="brand-mark" viewBox="0 0 256 256" aria-hidden="true">
            <rect width="256" height="256" rx="56" fill="currentColor" />
            <path d="M58 136 C 64 128, 74 128, 80 134 L 110 166 C 132 128, 160 94, 196 64 C 204 58, 214 62, 212 72 C 186 104, 150 150, 124 196 C 118 206, 104 208, 98 198 L 56 152 C 52 146, 52 140, 58 136 Z" fill="var(--bg)" />
            <circle cx="206" cy="204" r="9" fill="var(--bg)" />
          </svg>
          <span>indelible</span>
        </a>
        <nav class="nav" aria-label="Sections">
          <a class="nav-link" href="#how">How it works</a>
          <a class="nav-link nav-link--keep" href="#try">Try it</a>
          <a class="nav-link" href="#plan">Plan</a>
          <a class="nav-link" href="#details">Details</a>
          <a class="gh" href={repo} data-star>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            <span>GitHub</span><span class="star-count" data-star-count hidden></span>
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- ============================================================ HERO -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="kicker">An open-source skill for Claude Code</p>
            <h1 id="hero-title">Learning that survives the <span class="u">cold&nbsp;test.<svg class="pen-underline" viewBox="0 0 420 24" preserveAspectRatio="none" aria-hidden="true"><path class="pen" d="M6 14 C 90 6, 200 18, 300 9 S 400 10, 414 12" /></svg></span></h1>
            <p class="lead">indelible runs your self-study the way a strict, kind tutor would. You read theory on a sheet and then close it. Claude marks your work from photos of your paper. Everything comes back cold two days later, and only what you still know then counts.</p>

            <p class="recheck-ready" data-ready-note hidden>
              <svg viewBox="0 0 40 40" aria-hidden="true"><circle class="pen" cx="20" cy="20" r="15" /></svg>
              <span>Your 2-day recheck is ready. <a href="#try">Take it now</a></span>
            </p>

            <div class="install">
              <p class="install-label" id="install-hero">Install it in Claude Code</p>
              <div class="cmd-box" role="group" aria-labelledby="install-hero">
                <pre><code>{install.map((line) => <span class="cmd"><span class="prompt" aria-hidden="true">$ </span>{line}{'\n'}</span>)}</code></pre>
                <button class="copy" type="button" data-copy={install.join('\n')}><span class="c-idle">Copy</span><span class="c-done">Copied</span></button>
              </div>
              <p class="install-note">Then open Claude Code in an empty folder and say <em>“set me up for…”</em>, naming what you are learning. Needs Python 3.9 or later.</p>
            </div>

            <p class="hero-alt">Not sure yet? <a href="#try">Try a 2-minute sheet on this page</a> and come back for the recheck.</p>
          </div>

          <figure class="hero-sheet">
            <div class="sheet-stack">
              <span class="sheet-under" aria-hidden="true"></span>
              <img src={`${base}img/recheck-sheet.webp`} width="900" height="2198" alt="The top of a real 2-day recheck sheet printed by indelible: a rules box, a start time, and questions with an answer box and a Check line under each." />
            </div>
            <figcaption>A real 2-day recheck, printed by indelible. Every answer has a Check line under it.</figcaption>
          </figure>
        </div>
      </section>

      <!-- ============================================================ THE RULES -->
      <section class="section" id="how" aria-labelledby="how-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="how-title">Six rules, kept for you</h2>
            <p>These are the rules a good tutor holds you to. indelible keeps them in every session, including the days you would rather it didn’t.</p>
          </div>
          <ol class="rules">
            {rules.map((r, i) => (
              <li class="rule">
                <span class="rule-n" aria-hidden="true">
                  <svg viewBox="0 0 48 48"><path class="pen" d="M24 5 C 36 4, 44 13, 43 25 C 42 37, 33 44, 22 43 C 11 42, 4 33, 5 22 C 6 12, 14 6, 27 6" /></svg>
                  <span>{i + 1}</span>
                </span>
                <h3>{r.title}</h3>
                <p>{r.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- ============================================================ RULE 1, SHOWN -->
      <section class="section section--tight" id="close" aria-labelledby="close-title">
        <div class="wrap split">
          <div class="split-text">
            <h2 id="close-title">Read it, then close it</h2>
            <p>With the explanation in view, every answer is a lookup. It feels like knowing, and it isn’t.</p>
            <p>So theory comes on its own sheet. You read it, close it, and only then get the drills. Reopening is allowed, but it is written down, and those answers count as practice.</p>
          </div>

          <div class="split-demo closer" data-closer data-state="open">
            <div class="closer-stack">
              <article class="loose theory" aria-labelledby="theory-h">
                <p class="label">Theory sheet</p>
                <h3 id="theory-h" class="loose-title">The middle number</h3>
                <p>Sort the list, then take the value in the middle: 3, 9, 4, 12, 7 sorts to 3, 4, <strong>7</strong>, 9, 12.</p>
                <p>Add 100 to that list and the average jumps from 7 to 22.5. The middle number only moves to 8.</p>
                <p class="rule-box">Even count: take the average of the two middle values.</p>
                <p class="close-line">Close this sheet now. The drills come separately.</p>
              </article>
              <article class="loose drills" aria-labelledby="drills-h" aria-hidden="true">
                <p class="label">Drills · block A · six in a row</p>
                <h3 id="drills-h" class="loose-title">Find the middle number</h3>
                <ol class="drill-list">
                  <li><span>5, 1, 9</span><i></i></li>
                  <li><span>2, 8, 4, 6</span><i></i></li>
                  <li><span>10, 3, 3, 7, 1</span><i></i></li>
                </ol>
                <p class="gate">If your check failed on two of questions 1 to 3, stop and send a photo.</p>
              </article>
            </div>
            <div class="closer-bar">
              <button class="btn" type="button" data-closer-toggle><span class="w-open">Close the theory sheet</span><span class="w-closed">Open it again</span></button>
              <p class="closer-status" aria-live="polite" data-closer-status>The theory is open. The drills wait until you close it.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============================================================ RULE 2, SHOWN -->
      <section class="section section--tight" id="mixed" aria-labelledby="mixed-title">
        <div class="wrap split split--flip">
          <div class="split-text">
            <h2 id="mixed-title">Practise one kind at a time. Get tested on all of them, mixed.</h2>
            <p>Six in a row of one kind makes the step automatic.</p>
            <p>But a real exam never says which topic a question is from. So anything that measures you is shuffled and unlabelled, and you have to recognise the problem before you can solve it.</p>
          </div>

          <div class="split-demo pair">
            <div class="pair-sheet">
              <p class="label">Teaching block</p>
              <p class="pair-head">Block A · the middle number</p>
              <ol><li>5, 1, 9</li><li>2, 8, 4, 6</li><li>10, 3, 3, 7, 1</li><li>12, 15, 11, 90</li><li>0.5, 0.2, 0.9</li><li>6, 6, 1, 8, 2, 9</li></ol>
              <p class="pair-foot">One kind, six in a row</p>
            </div>
            <div class="pair-sheet pair-sheet--mixed">
              <p class="label">Recheck</p>
              <p class="pair-head">Sheet 07</p>
              <ol><li>Average of 2, 4, 9</li><li>Solve 2x − 3 = 11</li><li>Middle number of 4, 10, 6</li><li>20% of 45</li><li>For 1, 2, 3, 50: which is larger, the average or the middle number?</li><li>Solve x ÷ 4 = 2.5</li></ol>
              <p class="pair-foot">Mixed, with no headings</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============================================================ TRY IT -->
      <section class="section band" id="try" aria-labelledby="try-title">
        <div class="wrap split split--try">
          <div class="split-text">
            <h2 id="try-title">Try it: three questions, closed book</h2>
            <p>This sheet is real. Answer each question, then write a check beside it that works backwards. It is marked when you hand it in.</p>
            <ol class="steps">
              <li><strong>Today.</strong> Your score is practice. It does not count yet.</li>
              <li><strong>In two days.</strong> Come back to this page. You get the same kinds of question with fresh numbers, cold.</li>
              <li><strong>Then.</strong> That score is the one that counts.</li>
            </ol>
            <p class="small">Your answers stay in this browser. Nothing is sent anywhere.</p>
          </div>
          <div class="split-demo">
            <Trial />
          </div>
        </div>
      </section>

      <!-- ============================================================ 48 HOURS -->
      <section class="section" id="later" aria-labelledby="later-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="later-title">Today’s 6 of 6 doesn’t count yet</h2>
            <p>Same-day scores are practice. What counts is the 2-day recheck: fresh questions 44 to 72 hours later, with nothing looked at in the 24 hours before. Every miss then comes back after 1 day, 3 days, 1 week and 3 weeks.</p>
          </div>

          <figure class="chart" data-timeline>
            <figcaption class="chart-cap">One topic, from lesson to retired. Drag along the line, or use the arrow keys.</figcaption>
            <div class="track">
              <div class="axis" aria-hidden="true"></div>
              <div class="axis-fill" data-fill aria-hidden="true"></div>
              {stops.map((s, i) => (
                <span class={`node${s.counts ? ' node--counts' : ''}`} style={`left:${pos(i)}`} data-node={i} aria-hidden="true">
                  <span class="node-dot"></span><span class="node-when">{s.when}</span>
                </span>
              ))}
              <label class="visually-hidden" for="tl-range">Move along the timeline</label>
              <input id="tl-range" class="range" type="range" min="0" max={stops.length - 1} step="1" value="0" data-range aria-valuetext={`${stops[0].when}: ${stops[0].title}`} />
            </div>
            <div class="stop-card" aria-live="polite">
              {stops.map((s, i) => (
                <div class="stop" data-stop={i} hidden={i !== 0}>
                  <p class="stop-title"><span class="stop-when">{s.when}</span> {s.title}</p>
                  <p>{s.text}</p>
                  <p class={`stop-verdict${s.counts ? ' is-counts' : ''}`}>{s.verdict}</p>
                </div>
              ))}
            </div>
            <p class="chart-note">These are indelible’s default intervals, not measured results. You can change them.</p>
          </figure>
        </div>
      </section>

      <!-- ============================================================ PLAN -->
      <section class="section band" id="plan" aria-labelledby="plan-title">
        <div class="wrap">
          <div class="section-head">
            <h2 id="plan-title">Your first two weeks, planned around the rechecks</h2>
            <p>These are four of the questions indelible asks when you set it up. Change the answers and the plan follows its rules: a diagnostic before any teaching, and a protected recheck 44 to 72 hours after every lesson. Click a session to mark it missed.</p>
          </div>
          <Planner />
        </div>
      </section>

      <!-- ============================================================ SETUP -->
      <section class="section" id="setup" aria-labelledby="setup-title">
        <div class="wrap split split--setup">
          <div class="split-text">
            <h2 id="setup-title">The first eight minutes</h2>
            <p>A short interview, one question at a time, each with a default: your goal and date, where you are now, your materials, session length and days, when your head is clearest, when you sleep.</p>
            <p>You see a two-week plan first and the calendar question second. Nothing is written until you say yes to a one-screen summary. Then a diagnostic, before any teaching.</p>
          </div>

          <figure class="split-demo terminal">
            <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i><span>claude</span></div>
            <div class="tr-body">
              <p class="tr-c">(6 of 8) How long should a normal session be (15–20, 30, 45, 60, 90, or 120–150 min), and on how many days a week?</p>
              <p class="tr-y">&gt; 60 minutes, four days, never more than 90</p>
              <p class="tr-c">Your first two weeks: IELTS · ~4 h/week · 60-min sessions · exam 12 Dec</p>
              <pre class="tr-plan">          Week 1                           Week 2
Mon 07:00 Diagnostic, part A               New skill + 2-day recheck
Tue 07:00 Diagnostic, part B + results     rest
Thu 07:00 First skill: sheet, closed       2-day recheck + fixed mistakes
Sat 10:00 2-day recheck + second skill     Timed section</pre>
              <p class="tr-c">Want these in your calendar? I found Google Calendar.</p>
              <ol class="tr-opts"><li>Yes, and ask me before each batch of changes (recommended)</li><li>Yes, and you may move a missed block within 24 h</li><li>Give me a file to import (.ics)</li><li>No calendar: just tell me what’s next</li></ol>
            </div>
            <figcaption class="term-cap">Part of the setup in Claude Code, with a made-up learner.</figcaption>
          </figure>
        </div>
      </section>

      <!-- ============================================================ DETAILS -->
      <section class="section section--details" id="details" aria-labelledby="details-title">
        <div class="wrap">
          <h2 id="details-title">Good to know</h2>

          <div class="details-grid">
            <section aria-labelledby="where-h">
              <h3 id="where-h">Where it works</h3>
              <table class="where">
                <caption class="visually-hidden">Where indelible works in version 0.1</caption>
                <tbody>
                  <tr><th scope="row">Claude Code</th><td>Supported, in the terminal, the desktop app and the IDE extensions.</td></tr>
                  <tr><th scope="row">Cowork</th><td>Should work with a shared folder. Untested in v0.1.</td></tr>
                  <tr><th scope="row">claude.ai chat and mobile</th><td>Not yet: files don’t persist between chats there. A limited manual mode is offered instead.</td></tr>
                </tbody>
              </table>
            </section>

            <section aria-labelledby="data-h">
              <h3 id="data-h">Your data</h3>
              <ul class="plain">
                <li>Plain files in a folder you choose, on your own computer.</li>
                <li>The scripts make no network requests. Nothing is sent to the author.</li>
                <li>Calendar entries only through your own connector, after a preview and your yes.</li>
                <li>Answer keys stay sealed until your attempt is filed.</li>
              </ul>
              <p class="small"><a href={`${blob}/PRIVACY.md`}>Privacy policy</a> · <a href={`${blob}/README.md#what-it-runs-writes-and-sends`}>What it runs, writes and sends</a></p>
            </section>

            <section class="details-wide" aria-labelledby="limits-h">
              <h3 id="limits-h">Honest limits</h3>
              <div class="limits">
                <p>A skill cannot physically stop the model from breaking its own rules, so the rules that matter most do not rely on instructions alone. The only route to a printable sheet runs a sheet checker. The only route to an answer key needs your attempt filed first. The next session finds anything the last one skipped, and does it first.</p>
                <p>The method was developed with one learner over about four weeks. That is not a controlled study. The principles come from well-studied effects: retrieval practice (Roediger &amp; Karpicke, 2006), spacing (Cepeda et al., 2006) and interleaving (Rohrer &amp; Taylor, 2007). The numbers, like 48 hours and six questions a block, are defaults you can change.</p>
              </div>
            </section>
          </div>
        </div>
      </section>

      <!-- ============================================================ INSTALL -->
      <section class="cta" id="install" aria-labelledby="cta-title">
        <div class="wrap cta-in">
          <div>
            <h2 id="cta-title">Start with one subject</h2>
            <p class="cta-lead">Two commands in Claude Code. Then say <em>“set me up for…”</em> and answer a few questions.</p>
          </div>
          <div class="cta-install">
            <div class="cmd-box cmd-box--night">
              <pre><code>{install.map((line) => <span class="cmd"><span class="prompt" aria-hidden="true">$ </span>{line}{'\n'}</span>)}</code></pre>
              <button class="copy" type="button" data-copy={install.join('\n')}><span class="c-idle">Copy</span><span class="c-done">Copied</span></button>
            </div>
            <p class="cta-note">Or copy <code>skills/indelible</code> into <code>~/.claude/skills/</code>.</p>
            <p class="cta-links"><a href={repo}>Source on GitHub</a><a href={`${blob}/CHANGELOG.md`}>Changelog</a><a href={`${blob}/SECURITY.md`}>Security</a><a href={`${repo}/issues`}>Report an issue</a></p>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-in">
        <p>Designed and field-tested by <a href="https://github.com/romanprigodskii">@romanprigodskii</a>.</p>
        <p>MIT or Apache-2.0. Independent: not made, endorsed or supported by Anthropic. This page loads nothing from other sites except the star count, from GitHub.</p>
      </div>
    </footer>

    <script>
      // Copy
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(b.dataset.copy ?? ''); b.classList.add('is-done'); setTimeout(() => b.classList.remove('is-done'), 1600); } catch { /* stays selectable */ }
      }));

      // Rule 1: close the theory
      const closer = document.querySelector<HTMLElement>('[data-closer]');
      if (closer) {
        const btn = closer.querySelector<HTMLButtonElement>('[data-closer-toggle]')!;
        const status = closer.querySelector<HTMLElement>('[data-closer-status]')!;
        const theory = closer.querySelector<HTMLElement>('.theory')!;
        const drills = closer.querySelector<HTMLElement>('.drills')!;
        let reopened = false;
        btn.addEventListener('click', () => {
          const closing = closer.dataset.state === 'open';
          closer.dataset.state = closing ? 'closed' : 'open';
          theory.setAttribute('aria-hidden', String(closing));
          drills.setAttribute('aria-hidden', String(!closing));
          if (!closing) reopened = true;
          status.textContent = closing
            ? (reopened ? 'Closed again. These answers still count as practice: you looked.' : 'Closed. Now the drills: one kind of question, six in a row.')
            : 'Opened again. Allowed, and written down as “looked”.';
        });
      }

      // The 48-hour timeline
      const tl = document.querySelector<HTMLElement>('[data-timeline]');
      if (tl) {
        const range = tl.querySelector<HTMLInputElement>('[data-range]')!;
        const nodes = [...tl.querySelectorAll<HTMLElement>('[data-node]')];
        const cards = [...tl.querySelectorAll<HTMLElement>('[data-stop]')];
        const fill = tl.querySelector<HTMLElement>('[data-fill]')!;
        const show = (i: number) => {
          nodes.forEach((n, k) => { n.classList.toggle('is-past', k < i); n.classList.toggle('is-now', k === i); });
          cards.forEach((c, k) => { c.hidden = k !== i; });
          fill.style.transform = `scaleX(${parseFloat(nodes[i].style.left) / 100})`;
          range.setAttribute('aria-valuetext', cards[i].querySelector('.stop-title')?.textContent?.trim() ?? '');
        };
        range.addEventListener('input', () => show(Number(range.value)));
        show(0);
      }

      // A waiting recheck (set by the sheet in "Try it")
      if (document.documentElement.dataset.recheckReady === 'true') {
        document.querySelector<HTMLElement>('[data-ready-note]')?.removeAttribute('hidden');
      }

      // Star count, live from GitHub; hidden if the request fails or there are none yet
      const star = document.querySelector<HTMLElement>('[data-star]');
      if (star) {
        fetch('https://api.github.com/repos/romanprigodskii/indelible', { headers: { Accept: 'application/vnd.github+json' } })
          .then((r) => (r.ok ? r.json() : null))
          .then((d) => {
            const n = d && typeof d.stargazers_count === 'number' ? d.stargazers_count : 0;
            if (n > 0) {
              const out = star.querySelector<HTMLElement>('[data-star-count]')!;
              out.textContent = `★ ${n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}k` : n}`;
              out.hidden = false;
              star.setAttribute('aria-label', `GitHub, ${n} stars`);
            }
          })
          .catch(() => {});
      }
    </script>

