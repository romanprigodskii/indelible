---
// Sit a three-question sheet now; come back 44-72 hours later for the cold recheck.
// Everything stays in this browser (localStorage). Nothing is sent anywhere.
---
<div class="trial" data-trial>
  <div class="t-sheet">
    <div class="t-head">
      <p class="t-title" data-t-title>Practice sheet</p>
      <p class="t-meta"><span data-t-meta>3 questions · about 2 minutes · closed book</span></p>
    </div>
    <p class="t-rule">Write your answer. Then write one check that works backwards. The sheet is marked when you hand it in.</p>

    <form class="t-form" data-t-form novalidate>
      <ol class="t-items" data-t-items></ol>
      <div class="t-least">
        <label for="t-least" class="t-least-label">Least sure of</label>
        <select id="t-least" name="least">
          <option value="">none</option>
          <option value="1">question 1</option>
          <option value="2">question 2</option>
          <option value="3">question 3</option>
        </select>
      </div>
      <div class="t-actions">
        <button class="btn" type="submit" data-t-submit>Hand it in</button>
        <button class="btn btn--ghost" type="button" data-t-reset hidden>Start over</button>
      </div>
    </form>
  </div>

  <div class="t-result" aria-live="polite" data-t-result hidden></div>
</div>

<script>
  interface Q { id: string; text: string; answer: number; unit?: string; check: (a: number) => { line: string; ok: boolean }; }
  const fmt = (n: number) => (Math.round(n * 100) / 100).toString().replace('.', '.');
  const money = (n: number) => `€${Number.isInteger(Math.round(n * 100) / 100) ? String(Math.round(n)) : (Math.round(n * 100) / 100).toFixed(2)}`;

  // Day 0 and the recheck ask the same kinds of question with fresh numbers, in a different order.
  const SETS: Record<'first' | 'recheck', Q[]> = {
    first: [
      { id: 'a', text: '7 × 8 − 6', answer: 50, check: (a) => ({ line: `${fmt(a)} + 6 = ${fmt(a + 6)}${a + 6 === 56 ? ' = 7 × 8' : ', not 56'}`, ok: a + 6 === 56 }) },
      { id: 'b', text: 'A jacket costs €80 after a 20% discount. What was the price before the discount?', answer: 100, unit: '€', check: (a) => ({ line: `${money(a)} − 20% = ${money(a * 0.8)}${Math.abs(a * 0.8 - 80) < 0.005 ? '' : ', not €80'}`, ok: Math.abs(a * 0.8 - 80) < 0.005 }) },
      { id: 'c', text: 'What is 20% of 45?', answer: 9, check: (a) => ({ line: `5 × ${fmt(a)} = ${fmt(5 * a)}${5 * a === 45 ? '' : ', not 45'}`, ok: 5 * a === 45 }) },
    ],
    recheck: [
      { id: 'b', text: 'A coat costs €60 after a 25% discount. What was the price before the discount?', answer: 80, unit: '€', check: (a) => ({ line: `${money(a)} − 25% = ${money(a * 0.75)}${Math.abs(a * 0.75 - 60) < 0.005 ? '' : ', not €60'}`, ok: Math.abs(a * 0.75 - 60) < 0.005 }) },
      { id: 'c', text: 'What is 15% of 60?', answer: 9, check: (a) => ({ line: `${fmt(a)} ÷ 0.15 = ${fmt(a / 0.15)}${Math.abs(a / 0.15 - 60) < 0.005 ? '' : ', not 60'}`, ok: Math.abs(a / 0.15 - 60) < 0.005 }) },
      { id: 'a', text: '9 × 6 − 4', answer: 50, check: (a) => ({ line: `${fmt(a)} + 4 = ${fmt(a + 4)}${a + 4 === 54 ? ' = 9 × 6' : ', not 54'}`, ok: a + 4 === 54 }) },
    ],
  };

  const KEY = 'indelible-trial-v1';
  const H = 3600 * 1000;
  type Store = { firstAt: number; firstScore: number; recheckAt?: number; recheckScore?: number; lateBy?: number };
  const load = (): Store | null => { try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; } };
  const save = (s: Store | null) => { try { s ? localStorage.setItem(KEY, JSON.stringify(s)) : localStorage.removeItem(KEY); } catch { /* private mode: fine */ } };

  const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const when = (t: number) => { const d = new Date(t); return `${DAYS[d.getDay()]} at ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`; };
  const parse = (v: string) => {
    const s = v.replace(/[€\s]/g, '').replace(',', '.');
    if (!s) return NaN;
    return Number(s);
  };
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

  const TICK = '<svg class="t-mark" viewBox="0 0 40 32" role="img" aria-label="correct"><path class="pen" d="M5 17 C 9 20, 12 24, 15 27 C 21 17, 28 9, 36 4"/></svg>';
  const CROSS = '<svg class="t-mark" viewBox="0 0 40 40" role="img" aria-label="wrong"><path class="pen" d="M9 8 C 17 17, 24 25, 32 33 M32 8 C 24 16, 17 24, 8 32"/></svg>';

  const root = document.querySelector<HTMLElement>('[data-trial]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-t-form]')!;
    const items = root.querySelector<HTMLOListElement>('[data-t-items]')!;
    const result = root.querySelector<HTMLElement>('[data-t-result]')!;
    const title = root.querySelector<HTMLElement>('[data-t-title]')!;
    const meta = root.querySelector<HTMLElement>('[data-t-meta]')!;
    const submit = root.querySelector<HTMLButtonElement>('[data-t-submit]')!;
    const reset = root.querySelector<HTMLButtonElement>('[data-t-reset]')!;

    let mode: 'first' | 'recheck' = 'first';
    let store = load();

    const setMode = () => {
      store = load();
      const now = Date.now();
      if (!store) { mode = 'first'; }
      else if (store.recheckAt) { mode = 'recheck'; }
      else {
        const age = now - store.firstAt;
        mode = age >= 44 * H ? 'recheck' : 'first';
      }
    };

    const renderItems = (qs: Q[], locked: boolean) => {
      items.innerHTML = qs.map((q, i) => `
        <li class="t-item" data-q="${q.id}">
          <p class="t-q"><span class="t-n">${i + 1}</span>${esc(q.text)}</p>
          <div class="t-row">
            <label class="t-field"><span class="t-lab">Answer</span>
              <input name="ans-${q.id}" inputmode="decimal" autocomplete="off" ${locked ? 'disabled' : ''} placeholder="${q.unit === '€' ? '€' : ''}" /></label>
            <span class="t-slot" data-slot="${q.id}"></span>
          </div>
          <label class="t-field t-field--check"><span class="t-lab">Check</span>
            <input name="chk-${q.id}" autocomplete="off" ${locked ? 'disabled' : ''} placeholder="work it backwards" /></label>
          <p class="t-line" data-line="${q.id}" hidden></p>
        </li>`).join('');
    };

    const show = () => {
      setMode();
      result.hidden = true;
      reset.hidden = !store;
      const now = Date.now();
      if (mode === 'first' && store && !store.recheckAt) {
        // Sat already, waiting for the window.
        const opens = store.firstAt + 44 * H;
        title.textContent = 'Practice sheet (handed in)';
        meta.textContent = `Your score today: ${store.firstScore} of 3 [practice]`;
        renderItems(SETS.first, true);
        submit.hidden = true;
        result.hidden = false;
        result.innerHTML = `<p class="r-big">Too soon for the recheck.</p>
          <p>It opens ${esc(when(opens))} (44 hours after you sat it) and is best taken before ${esc(when(store.firstAt + 72 * H))}. Nothing you did today counts until then.</p>
          <p><button class="btn btn--ghost" type="button" data-ics>Put the recheck in my calendar (.ics)</button></p>`;
        wireIcs(opens);
        return;
      }
      if (mode === 'recheck' && store && store.recheckAt) {
        title.textContent = '2-day recheck (done)';
        meta.textContent = `Day 0: ${store.firstScore} of 3 [practice] · recheck: ${store.recheckScore} of 3 [measured]`;
        renderItems(SETS.recheck, true);
        submit.hidden = true;
        result.hidden = false;
        result.innerHTML = verdictHtml(store);
        return;
      }
      if (mode === 'recheck') {
        const age = store ? Math.round((now - store.firstAt) / H) : 0;
        title.textContent = '2-day recheck';
        meta.textContent = `Fresh numbers, a different order, no notes. ${age} hours since you sat the first sheet${age > 72 ? ' (late: labelled as such)' : ''}.`;
        renderItems(SETS.recheck, false);
        submit.hidden = false;
        return;
      }
      title.textContent = 'Practice sheet';
      meta.textContent = '3 questions · about 2 minutes · closed book';
      renderItems(SETS.first, false);
      submit.hidden = false;
    };

    const verdictHtml = (s: Store) => {
      const late = (s.recheckAt! - s.firstAt) > 72 * H;
      const held = s.recheckScore! >= 2;
      return `<p class="r-big">${held ? 'It held.' : 'It did not hold yet.'}</p>
        <p>On the day: ${s.firstScore} of 3, which was practice. Two days later, cold, with fresh numbers: <strong>${s.recheckScore} of 3</strong>${late ? ', taken late and labelled with its real interval' : ''}. ${held ? 'That is the score that counts.' : 'The misses go on the ladder: back in 1 day, 3 days, 1 week and 3 weeks.'}</p>
        <p>That is the whole method, at the size of three questions. indelible runs it for a real subject, with your calendar.</p>`;
    };

    function wireIcs(opens: number) {
      const b = result.querySelector<HTMLButtonElement>('[data-ics]');
      if (!b) return;
      b.addEventListener('click', () => {
        const z = (t: number) => new Date(t).toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
        const url = location.href.split('#')[0] + '#try';
        const ics = [
          'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//indelible//site//EN', 'BEGIN:VEVENT',
          `UID:site-recheck-${opens}@indelible`, `DTSTAMP:${z(Date.now())}`,
          `DTSTART:${z(opens)}`, `DTEND:${z(opens + 10 * 60 * 1000)}`,
          'SUMMARY:2-day recheck (3 questions)',
          `DESCRIPTION:Closed book. Open ${url} and take the recheck cold.`,
          `URL:${url}`,
          'BEGIN:VALARM', 'TRIGGER:-PT15M', 'ACTION:DISPLAY', 'DESCRIPTION:2-day recheck', 'END:VALARM',
          'END:VEVENT', 'END:VCALENDAR', '',
        ].join('\r\n');
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([ics], { type: 'text/calendar' }));
        a.download = 'indelible-recheck.ics';
        document.body.appendChild(a);
        a.click();
        setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
      });
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const qs = SETS[mode];
      let score = 0;
      const least = String(new FormData(form).get('least') || '');
      qs.forEach((q, i) => {
        const input = form.querySelector<HTMLInputElement>(`[name="ans-${q.id}"]`)!;
        const a = parse(input.value);
        const right = Number.isFinite(a) && Math.abs(a - q.answer) < 0.005;
        if (right) score++;
        const slot = form.querySelector<HTMLElement>(`[data-slot="${q.id}"]`)!;
        slot.innerHTML = right ? TICK : CROSS;
        const line = form.querySelector<HTMLElement>(`[data-line="${q.id}"]`)!;
        if (!right) {
          line.hidden = false;
          line.innerHTML = Number.isFinite(a)
            ? `<span class="t-lab">The check that catches it</span> ${esc(q.check(a).line)}`
            : `<span class="t-lab">No answer</span> “I don’t know” is an accepted answer. It still comes back.`;
        }
        input.disabled = true;
        form.querySelector<HTMLInputElement>(`[name="chk-${q.id}"]`)!.disabled = true;
        if (least === String(i + 1)) slot.insertAdjacentHTML('beforeend', `<span class="t-ls">${right ? 'least sure, but right' : 'least sure, and wrong'}</span>`);
      });
      submit.hidden = true;
      reset.hidden = false;
      result.hidden = false;
      const now = Date.now();
      if (mode === 'first') {
        save({ firstAt: now, firstScore: score });
        result.innerHTML = `<p class="r-big">${score} of 3. It does not count yet.</p>
          <p>Same-day scores are practice. Come back in two days: this page will give you the same kinds of question with fresh numbers, cold. It opens ${esc(when(now + 44 * H))}.</p>
          <p class="r-small">Remembered only in this browser. Nothing is sent anywhere.</p>
          <p><button class="btn btn--ghost" type="button" data-ics>Put the recheck in my calendar (.ics)</button></p>`;
        wireIcs(now + 44 * H);
      } else {
        const s = { ...(store as Store), recheckAt: now, recheckScore: score };
        save(s);
        result.innerHTML = verdictHtml(s);
      }
      result.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    });

    reset.addEventListener('click', () => { save(null); form.reset(); show(); });
    show();

    // Let the cover know when a recheck is waiting.
    const s = load();
    if (s && !s.recheckAt && Date.now() - s.firstAt >= 44 * H) {
      document.documentElement.dataset.recheckReady = 'true';
    }
  }
</script>

<style>
  .trial {
    display: grid;
    gap: var(--space-md);
  }

  .t-sheet {
    padding: clamp(1rem, 0.6rem + 2vw, 2rem);
    border: 1.5px solid var(--print);
    background: var(--paper);
  }

  .t-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-md);
    padding-bottom: var(--space-xs);
    border-bottom: 2px solid var(--print);
  }

  .t-title {
    font-family: var(--sans);
    font-weight: 800;
    font-size: var(--text-lg);
  }

  .t-meta {
    font-family: var(--sans);
    font-size: var(--text-xs);
    color: var(--print-soft);
  }

  .t-rule {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--print-soft);
    font-style: italic;
  }

  .t-form :global(.t-items) {
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-lg);
  }

  .t-form :global(.t-q) {
    display: flex;
    gap: var(--space-xs);
    font-size: var(--text-base);
  }

  .t-form :global(.t-n) {
    flex: none;
    font-family: var(--sans);
    font-weight: 800;
    width: 1.4rem;
  }

  .t-form :global(.t-row) {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
    padding-left: 2.15rem;
  }

  .t-form :global(.t-field) {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .t-form :global(.t-field--check) {
    margin-top: var(--space-xs);
    padding-left: 2.15rem;
  }

  .t-form :global(.t-lab) {
    font-family: var(--sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--print-soft);
    min-width: 4.6rem;
  }

  .t-form :global(input) {
    min-height: 2.6rem;
    width: 9rem;
    padding: 0 0.6rem;
    border: 1.5px solid var(--box);
    border-radius: 2px;
    background: var(--paper);
    color: var(--graphite);
    font-family: var(--serif);
    font-size: 1.15rem;
  }

  .t-form :global(.t-field--check input) {
    width: min(22rem, 100%);
    border-width: 0 0 1.5px;
    border-radius: 0;
    font-style: italic;
  }

  .t-form :global(input:focus-visible) {
    outline: none;
    border-color: var(--print);
    box-shadow: 0 2px 0 var(--print);
  }

  .t-form :global(input:disabled) {
    color: var(--graphite);
    background: transparent;
  }

  .t-form :global(.t-slot) {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.6rem;
  }

  .t-form :global(.t-mark) {
    width: 2.3rem;
    height: 2rem;
  }

  .t-form :global(.t-ls) {
    font-family: var(--sans);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--marker);
  }

  .t-form :global(.t-line) {
    margin-top: var(--space-2xs);
    padding: var(--space-2xs) var(--space-sm);
    margin-left: 2.15rem;
    background: var(--marker-wash);
    color: var(--print);
    font-style: italic;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem var(--space-xs);
    align-items: baseline;
  }

  .t-form :global(.t-line .t-lab) {
    min-width: 0;
    font-style: normal;
    color: var(--marker);
  }

  .t-least {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    padding-top: var(--space-sm);
    border-top: 1.5px solid var(--print);
  }

  .t-least-label {
    font-family: var(--sans);
    font-weight: 800;
    font-size: var(--text-sm);
  }

  .t-least select {
    min-height: 2.4rem;
    padding: 0 0.5rem;
    border: 1.5px solid var(--box);
    background: var(--paper);
    font: inherit;
    font-size: var(--text-sm);
  }

  .t-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .t-result {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-md);
    border: 2px solid var(--marker);
    background: var(--paper);
  }

  .t-result :global(.r-big) {
    font-family: var(--sans);
    font-weight: 800;
    font-size: var(--text-lg);
    color: var(--marker);
  }

  .t-result :global(.r-small) {
    font-size: var(--text-sm);
    color: var(--print-soft);
  }

  @media (max-width: 40rem) {
    .t-form :global(.t-row),
    .t-form :global(.t-field--check) {
      padding-left: 0;
    }

    .t-form :global(.t-line) {
      margin-left: 0;
    }

    .t-form :global(.t-lab) {
      min-width: 4rem;
    }

    .t-form :global(input) {
      width: 7.5rem;
    }
  }
</style>
