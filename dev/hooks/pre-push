#!/bin/sh
# Runs the privacy check before every push, and stops the push on any exit but 0.
# Turn it on once per clone:  git config core.hooksPath dev/hooks
# It needs the local, git-ignored denylist (dev/.privacy-denylist.txt): README.md, "Contributing".
root=$(git rev-parse --show-toplevel) || exit 1
# Try python3 by running it, not by finding it: on Windows a python3 on PATH can be
# the Microsoft Store stub, which only fails. The py launcher comes with python.org Python.
if python3 -c 'import sys' >/dev/null 2>&1; then
    exec python3 "$root/dev/privacy_grep.py"
fi
exec py -3 "$root/dev/privacy_grep.py"
